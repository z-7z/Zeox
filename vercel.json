{
  "rewrites": [
    { "source": "/login", "destination": "/index.html" },
    { "source": "/main", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/dashboard/overview", "destination": "/index.html" },
    { "source": "/obfuscate", "destination": "/index.html" },
    { "source": "/usages", "destination": "/index.html" },
    { "source": "/encrypt", "destination": "/index.html" },
    { "source": "/vault", "destination": "/index.html" },
    { "source": "/showcase", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
